{
  "name": "needbridge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "kill-port": "node -e \"try { const { execSync } = require('child_process'); const platform = process.platform; if (platform === 'win32') { execSync('for /f \\\"usebackq tokens=5\\\" %i in (`netstat -ano -p tcp ^| findstr :3000`) do taskkill /PID %i /F 2>nul', { stdio: 'inherit', shell: true }); } else { execSync('lsof -ti :3000 | xargs -r kill -9', { stdio: 'inherit', shell: true }); } } catch (err) {} console.log('Port 3000 cleared');\"",
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "preview": "node dist-server/index.js",
    "seed": "tsx server/db/seed.ts",
    "admin:create": "tsx server/db/createAdmin.ts",
    "test": "tsx server/tests/suite.test.ts",
    "db:reset": "node -e \"require('fs').rmSync('./data', { recursive: true, force: true })\" && npm run seed",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.1.1",
    "@fontsource/outfit": "^5.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.2",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.4.9",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.10.3",
    "morgan": "^1.10.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.5",
    "react": "^19.0.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.6.3",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3",
    "zod": "^3.25.73"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
