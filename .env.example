# ─── NeedBridge Environment Configuration ────────────────────────────────────
# Copy this file to .env and fill in your values.
# Run: cp .env.example .env

# MongoDB Atlas connection string (required for persistent data)
# Get this from: MongoDB Atlas → Your Cluster → Connect → Drivers
# Ask the project owner for the shared team connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.nlnqa2j.mongodb.net/needbridge?retryWrites=true&w=majority&appName=Cluster0

# Server port (optional, defaults to 3000)
# PORT=3000

# JWT secret for auth tokens (optional, auto-generated if not set)
# JWT_SECRET=your-secret-key-here
